  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:apk": "npx eas-cli build -p android --profile preview",
    "build:aab": "npx eas-cli build -p android --profile production",
    "ota:preview": "npx eas-cli update --platform android --channel preview --message \"preview update\"",
    "ota:prod": "npx eas-cli update --platform android --channel production --message \"production update\""
  },
